   "metadata": {},
   "outputs": [],
   "source": [
    "# numpy는 숫자 여러 개를 배열로 묶어 한 번에 계산하게 해 주는 라이브러리\n",
    "# 이 노트북에서는 데이터 준비/정규화/학습 전 확인 같은 'NumPy 흐름'에 사용\n",
    "import numpy as np\n",
    "\n",
    "# torch는 PyTorch 라이브러리\n",
    "# 이번 노트북에서는 (1) 자동 미분(autograd)과 (2) optimizer(torch.optim.SGD)를 쓰기 위해 사용\n",
    "# - 자동 미분 : 사람이 미분 공식을 적지 않아도 PyTorch가 a.grad, b.grad를 계산해 주는 기능\n",
    "# - optimizer: 사람이 직접 하던 a, b 업데이트를 PyTorch가 대신 수행해 주는 도구\n",
    "import torch"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "cbeeaee0",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "입력값 X: [160 170 180 190]\n",
      "정답값 y: [0 0 1 1]\n"
     ]
    }
   ],
   "source": [
    "# 1. 입력값 X와 정답 y 준비(이전 파일과 동일)\n",
    "\n",
    "# X: 입력값으로, 여기서는 사람의 키(cm)를 사용\n",
    "#    np.array([...])는 여러 숫자를 하나의 NumPy 배열로 묶는 것\n",
    "X = np.array([160, 170, 180, 190])\n",
    "\n",
    "# y: 정답값으로, 0은 농구선수 아님, 1은 농구선수임\n",
    "#    x와 y는 순서대로 짝지어짐. 즉, 키 160cm -> 정답 0, 키 190cm -> 정답 1\n",
    "y = np.array([0, 0, 1, 1])\n",
    "\n",
    "print('입력값 X:', X)\n",
    "print('정답값 y:', y)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "9463a395",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "입력값 평균 X_mean: 175.0\n",
      "입력값 표준편차 X_std: 11.180339887498949\n",
      "정규화된 입력값 X_norm: [-1.34164079 -0.4472136   0.4472136   1.34164079]\n"
     ]
    }
   ],
   "source": [
    "# 2. 입력값 정규화 (이전 파일과 동일)\n",
    "\n",
    "# 평균과 표준편차를 계산\n",
    "# - 평균: 데이터의 중심(가운데쯤 되는 값)\n",
    "# - 표준편차: 데이터가 평균에서 얼마나 넓게 퍼져 있는지를 나타내는 값\n",
    "X_mean = np.mean(X)\n",
    "X_std = np.std(X)\n",
    "\n",
    "# 정규화 공식: (원본값 - 평균) / 표준편차\n",
    "# 입력값의 범위를 0 근처로 비슷하게 맞추면 학습이 더 안정적으로 진행됨\n",
    "# 주의: 실제 학습에는 원래 키 X가 아니라, 정규화된 입력값 X_norm을 사용\n",
    "#       (X_mean, X_std는 나중에 '새 입력값 예측'에서도 똑같이 다시 씀)\n",
    "X_norm = (X - X_mean) / X_std\n",
    "\n",
    "print('입력값 평균 X_mean:', X_mean)\n",
    "print('입력값 표준편차 X_std:', X_std)\n",
    "print('정규화된 입력값 X_norm:', X_norm)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "50c584ea",
